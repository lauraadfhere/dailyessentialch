# Values in this file are safe placeholders only. Put real values in .env.local.
# Public origin used for canonicals, hreflang, Open Graph URLs, the sitemap and robots.txt.
# No trailing slash; defaults to https://dailyessential.ch when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

NEXT_PUBLIC_PARSE_SERVER_URL=https://your-parse-server.example/parse
NEXT_PUBLIC_PARSE_APP_ID=your-public-app-id

PARSE_SERVER_URL=https://your-parse-server.example/parse
PARSE_APP_ID=your-server-app-id
PARSE_MASTER_KEY=your-master-key
PARSE_REST_KEY=your-rest-api-key

# Admin area (/admin). ADMIN_SESSION_SECRET is optional; it defaults to ADMIN_PASSWORD.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=a-long-random-string

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-r2-bucket
R2_PUBLIC_URL=https://your-public-bucket.example
